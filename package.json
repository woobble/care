{
  "name": "care-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "modules/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "NODE_ENV=test turbo run openapi --filter=@care/api && NODE_ENV=test turbo run build",
    "lint": "turbo run lint",
    "format": "oxfmt --config oxfmt.json . '!apps/web/test-results/**' '!apps/api/openapi.json' '!packages/api-client/src/generated/**'",
    "format:check": "oxfmt --config oxfmt.json --check . '!apps/web/test-results/**' '!apps/api/openapi.json' '!packages/api-client/src/generated/**'",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "i18n:check": "bun run --filter @care/web i18n:check",
    "test:integration": "turbo run test:integration",
    "test:e2e": "bun run infra:up && bun run migrate && bun run seed && NODE_ENV=test turbo run test:e2e",
    "migrate": "bun run --filter @care/api migrate",
    "seed": "bun run --filter @care/api seed",
    "pilot:seed": "bun run --filter @care/api pilot:seed",
    "pilot:seed:identity": "DEV_SEED_TENANT_SLUG=muster-betreuungsdienst-nrw DEV_SEED_ROLE=Office bun run --filter @care/api seed:identity",
    "seed:identity": "bun run --filter @care/api seed:identity",
    "infra:up": "bun scripts/local-compose.mjs up",
    "infra:down": "bun scripts/local-compose.mjs down",
    "deploy:check": "node scripts/deploy.mjs preflight",
    "deploy:setup": "node scripts/deploy-setup.mjs",
    "deploy:up": "node scripts/deploy.mjs up",
    "deploy:bootstrap-admin": "node scripts/deploy.mjs bootstrap-admin",
    "backup:create": "node scripts/deploy.mjs create",
    "backup:verify": "node scripts/deploy.mjs verify",
    "backup:restore": "node scripts/deploy.mjs restore",
    "backup:prune": "node scripts/deploy.mjs prune",
    "clean": "node scripts/clean.mjs",
    "routing:setup": "node scripts/routing.mjs setup",
    "routing:update": "node scripts/routing.mjs update",
    "routing:status": "node scripts/routing.mjs status",
    "reset": "bash scripts/reset.sh"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "supertest": "^7.3.1",
    "turbo": "^2.11.8",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@hey-api/json-schema-ref-parser>js-yaml": "4.3.2",
    "fastify": "5.12.7"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24"
  },
  "packageManager": "bun@1.4.2"
}
