{
  "name": "care-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "modules/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run openapi --filter=@care/api && turbo run build",
    "lint": "turbo run lint",
    "format": "oxfmt --config oxfmt.json . '!apps/web/test-results/**' '!apps/api/openapi.json' '!packages/api-client/src/generated/**'",
    "format:check": "oxfmt --config oxfmt.json --check . '!apps/web/test-results/**' '!apps/api/openapi.json' '!packages/api-client/src/generated/**'",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "bun run infra:up && bun run migrate && bun run seed && turbo run test:e2e",
    "migrate": "bun run --filter @care/api migrate",
    "seed": "bun run --filter @care/api seed",
    "seed:identity": "bun run --filter @care/api seed:identity",
    "infra:up": "docker compose up -d --wait && docker compose --profile bootstrap run --rm --no-deps seaweedfs-init",
    "infra:down": "docker compose down",
    "reset": "bash scripts/reset.sh"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/supertest": "^7.2.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "supertest": "^7.3.1",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24"
  },
  "packageManager": "bun@1.4.2"
}
