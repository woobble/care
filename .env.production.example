# Copy to .env.production, set permissions to 0600, and replace every placeholder.
# Store referenced secret files under ./secrets with mode 0600 and owner UID 1000
# so the runtime containers' unprivileged bun user can read the Compose mounts.
NODE_ENV=production

WEB_HOST=care.example.org
API_HOST=api.care.example.org
AUTHENTIK_HOST=login.care.example.org
WEB_ORIGIN=https://care.example.org
API_PUBLIC_URL=https://api.care.example.org
API_PUBLIC_ORIGIN=https://api.care.example.org
AUTHENTIK_PUBLIC_URL=https://login.care.example.org
AUTHENTIK_WEB__BASE_URL=https://login.care.example.org
OIDC_ISSUER=https://login.care.example.org/application/o/care-platform/
OIDC_REDIRECT_URI=https://care.example.org/api/auth/callback/authentik
OIDC_CLIENT_ID=care-platform
OIDC_CLIENT_SECRET=REPLACE_WITH_AUTHENTIK_CLIENT_SECRET
CADDY_EMAIL=operator@example.org
TRUSTED_PROXY_HOPS=1

# These remain in the protected Compose environment because Authentik and
# PostgreSQL consume them directly. Generate unique values for this deployment.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
CARE_APP_PASSWORD=REPLACE_WITH_RANDOM_SECRET
CARE_WORKER_PASSWORD=REPLACE_WITH_RANDOM_SECRET
AUTHENTIK_SECRET_KEY=REPLACE_WITH_AT_LEAST_50_RANDOM_CHARACTERS
AUTHENTIK_BOOTSTRAP_PASSWORD=REPLACE_WITH_RANDOM_SECRET
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_SECRET
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_FROM=care@example.org
SMTP_USERNAME=REPLACE_WITH_SMTP_USER
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD

# The files contain complete connection URLs or secret values; use URL-encoded
# PostgreSQL passwords in connection URLs.
DATABASE_URL_FILE=./secrets/care-database-url
MIGRATION_DATABASE_URL_FILE=./secrets/care-migration-database-url
WORKER_DATABASE_URL_FILE=./secrets/care-worker-database-url
AUTH_SECRET_FILE=./secrets/web-auth-secret
# Application object-storage credentials; never reuse the SeaweedFS bucket-init identity.
S3_ACCESS_KEY_FILE=./secrets/s3-access-key
S3_SECRET_KEY_FILE=./secrets/s3-secret-key
SEAWEEDFS_S3_CONFIG_FILE=./secrets/seaweedfs-s3.json
# Separate identity used only by the SeaweedFS bucket-creation helper.
S3_INIT_ACCESS_KEY_FILE=./secrets/seaweedfs-init-access-key
S3_INIT_SECRET_KEY_FILE=./secrets/seaweedfs-init-secret-key

S3_ENDPOINT=http://seaweedfs:8333
S3_REGION=eu-central-1
S3_BUCKET=care-documents
S3_FORCE_PATH_STYLE=true
ROUTING_OSRM_URL=
ROUTING_OSRM_PROBE_FROM=
ROUTING_OSRM_PROBE_TO=
WORKER_POLL_INTERVAL_MS=1000
SCHEDULE_GENERATION_HORIZON_DAYS=28
LOG_LEVEL=info
# Optional OTLP endpoint for API/worker traces. Enable the observability Compose
# profile and set this to http://otel-collector:4318 to collect traces.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Keep backups outside the repository on an encrypted, access-restricted volume.
BACKUP_DIR=/srv/care-backups
BACKUP_RETENTION_DAYS=30
OPERATOR_SECRETS_DIR=./secrets
