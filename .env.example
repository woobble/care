# Local development values only. Replace every secret before deployment.
NODE_ENV=development

POSTGRES_PASSWORD=care_owner_dev_only
CARE_APP_PASSWORD=care_dev_only
CARE_WORKER_PASSWORD=care_worker_dev_only
DATABASE_URL=postgres://care_app:care_dev_only@localhost:5432/care
MIGRATION_DATABASE_URL=postgres://care_owner:care_owner_dev_only@localhost:5432/care
WORKER_DATABASE_URL=postgres://care_worker:care_worker_dev_only@localhost:5432/care

OIDC_ISSUER=http://localhost:9000/application/o/care-platform/
OIDC_CLIENT_ID=care-platform
OIDC_CLIENT_SECRET=care-local-client-secret
AUTH_SECRET=replace-with-at-least-32-random-bytes-before-deployment
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://localhost:3001
SCHEDULE_GENERATION_HORIZON_DAYS=28
# Optional self-hosted OSRM backend (driving mode only).
# ROUTING_OSRM_URL=http://localhost:5000

S3_ENDPOINT=http://localhost:9002
S3_REGION=us-east-1
S3_BUCKET=care-documents
S3_ACCESS_KEY=care-s3
S3_SECRET_KEY=care-s3-dev-only
S3_FORCE_PATH_STYLE=true

AUTHENTIK_SECRET_KEY=local-authentik-secret-replace-before-deployment
AUTHENTIK_BOOTSTRAP_PASSWORD=local-admin-password-replace-before-deployment
AUTHENTIK_E2E_API_TOKEN=care-e2e-local-api-token
DEV_SEED_OIDC_SUB=
GRAFANA_ADMIN_PASSWORD=care-grafana-dev-only
MAILPIT_SMTP_PORT=1026
