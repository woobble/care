{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", ".env.*"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["SWC_NATIVE_BINDING_CACHE"]
    },
    "openapi": {
      "dependsOn": ["^build"],
      "outputs": ["openapi.json"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "NODE_ENV",
        "SWC_NATIVE_BINDING_CACHE",
        "DATABASE_URL",
        "WORKER_DATABASE_URL",
        "OIDC_ISSUER",
        "OIDC_CLIENT_ID",
        "OIDC_CLIENT_SECRET",
        "AUTH_SECRET",
        "API_INTERNAL_URL",
        "WEB_ORIGIN",
        "OTEL_EXPORTER_OTLP_ENDPOINT",
        "PORT",
        "WORKER_POLL_INTERVAL_MS"
      ],
      "passThroughEnv": [
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_BUCKET",
        "S3_ACCESS_KEY",
        "S3_SECRET_KEY",
        "S3_FORCE_PATH_STYLE"
      ]
    },
    "@care/web#dev": {
      "with": ["@care/api#dev"],
      "env": [
        "NODE_ENV",
        "SWC_NATIVE_BINDING_CACHE",
        "DATABASE_URL",
        "OIDC_ISSUER",
        "OIDC_CLIENT_ID",
        "OIDC_CLIENT_SECRET",
        "AUTH_SECRET",
        "API_INTERNAL_URL",
        "WEB_ORIGIN",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_BUCKET",
        "S3_ACCESS_KEY",
        "S3_SECRET_KEY",
        "S3_FORCE_PATH_STYLE"
      ]
    },
    "lint": { "dependsOn": ["^lint"] },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "dependsOn": ["^build"] },
    "test:integration": { "dependsOn": ["^build"], "cache": false },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "env": [
        "NODE_ENV",
        "SWC_NATIVE_BINDING_CACHE",
        "DATABASE_URL",
        "MIGRATION_DATABASE_URL",
        "OIDC_ISSUER",
        "OIDC_CLIENT_ID",
        "OIDC_CLIENT_SECRET",
        "AUTH_SECRET",
        "AUTHENTIK_E2E_API_TOKEN",
        "API_INTERNAL_URL",
        "WEB_ORIGIN",
        "DEV_SEED_OIDC_SUB",
        "PLAYWRIGHT_BASE_URL",
        "PLAYWRIGHT_BROWSERS_PATH",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_BUCKET",
        "S3_ACCESS_KEY",
        "S3_SECRET_KEY",
        "S3_FORCE_PATH_STYLE"
      ]
    }
  }
}
