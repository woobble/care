{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "paths": {
      "@app/api/*": ["./apps/api/src/*"],
      "@app/web/*": ["./apps/web/src/*"],
      "@app/worker/*": ["./apps/worker/src/*"],
      "@module/audit/*": ["./modules/audit/src/*"],
      "@module/benefits/*": ["./modules/benefits/src/*"],
      "@module/billing/*": ["./modules/billing/src/*"],
      "@module/care-documentation/*": ["./modules/care-documentation/src/*"],
      "@module/clients/*": ["./modules/clients/src/*"],
      "@module/communications/*": ["./modules/communications/src/*"],
      "@module/documents/*": ["./modules/documents/src/*"],
      "@module/employees/*": ["./modules/employees/src/*"],
      "@module/identity/*": ["./modules/identity/src/*"],
      "@module/operations/*": ["./modules/operations/src/*"],
      "@module/organizations/*": ["./modules/organizations/src/*"],
      "@module/platform/*": ["./modules/platform/src/*"],
      "@module/scheduling/*": ["./modules/scheduling/src/*"],
      "@module/service-agreements/*": ["./modules/service-agreements/src/*"],
      "@module/service-evidence/*": ["./modules/service-evidence/src/*"],
      "@module/services/*": ["./modules/services/src/*"],
      "@module/visit-execution/*": ["./modules/visit-execution/src/*"],
      "@package/api-client/*": ["./packages/api-client/src/*"],
      "@package/auth/*": ["./packages/auth/src/*"],
      "@package/config/*": ["./packages/config/src/*"],
      "@package/contracts/*": ["./packages/contracts/src/*"],
      "@package/database/*": ["./packages/database/src/*"],
      "@package/events/*": ["./packages/events/src/*"],
      "@package/logging/*": ["./packages/logging/src/*"],
      "@package/observability/*": ["./packages/observability/src/*"],
      "@package/permissions/*": ["./packages/permissions/src/*"],
      "@package/storage/*": ["./packages/storage/src/*"],
      "@package/testing/*": ["./packages/testing/src/*"],
      "@package/ui/*": ["./packages/ui/src/*"],
      "@module/onboarding/*": ["./modules/onboarding/src/*"]
    },
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": ["bun", "node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
