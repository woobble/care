{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "paths": {
      "@app/api/*": ["./apps/api/*"],
      "@app/web/*": ["./apps/web/*"],
      "@app/worker/*": ["./apps/worker/*"],
      "@module/audit/*": ["./modules/audit/*"],
      "@module/benefits/*": ["./modules/benefits/*"],
      "@module/billing/*": ["./modules/billing/*"],
      "@module/care-documentation/*": ["./modules/care-documentation/*"],
      "@module/clients/*": ["./modules/clients/*"],
      "@module/communications/*": ["./modules/communications/*"],
      "@module/documents/*": ["./modules/documents/*"],
      "@module/employees/*": ["./modules/employees/*"],
      "@module/identity/*": ["./modules/identity/*"],
      "@module/operations/*": ["./modules/operations/*"],
      "@module/organizations/*": ["./modules/organizations/*"],
      "@module/platform/*": ["./modules/platform/*"],
      "@module/scheduling/*": ["./modules/scheduling/*"],
      "@module/service-agreements/*": ["./modules/service-agreements/*"],
      "@module/service-evidence/*": ["./modules/service-evidence/*"],
      "@module/services/*": ["./modules/services/*"],
      "@module/visit-execution/*": ["./modules/visit-execution/*"],
      "@package/api-client/*": ["./packages/api-client/*"],
      "@package/auth/*": ["./packages/auth/*"],
      "@package/config/*": ["./packages/config/*"],
      "@package/contracts/*": ["./packages/contracts/*"],
      "@package/database/*": ["./packages/database/*"],
      "@package/events/*": ["./packages/events/*"],
      "@package/logging/*": ["./packages/logging/*"],
      "@package/observability/*": ["./packages/observability/*"],
      "@package/permissions/*": ["./packages/permissions/*"],
      "@package/storage/*": ["./packages/storage/*"],
      "@package/testing/*": ["./packages/testing/*"],
      "@package/ui/*": ["./packages/ui/*"]
    },
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": ["bun", "node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
