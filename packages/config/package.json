{
  "name": "@care/config",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./load-env": "./src/load-env.ts"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun --packages external",
    "lint": "oxlint src",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit --pretty false -p tsconfig.json"
  },
  "dependencies": {
    "dotenv": "^18.0.5",
    "zod": "^4.6.5"
  }
}
