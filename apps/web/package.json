{
  "name": "@care/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "oxlint src next.config.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit --pretty false -p tsconfig.json",
    "test": "bun test src/i18n",
    "i18n:check": "bun run scripts/check-i18n.ts",
    "test:e2e": "playwright test --config=playwright.config.ts"
  },
  "dependencies": {
    "@care/api-client": "workspace:*",
    "@care/config": "workspace:*",
    "@care/database": "workspace:*",
    "@care/identity": "workspace:*",
    "@care/scheduling": "workspace:*",
    "@care/ui": "workspace:*",
    "better-auth": "^1.7.7",
    "next": "^16.4.0",
    "next-intl": "^4.14.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@care/storage": "workspace:*",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "pg": "^8.23.1",
    "tailwindcss": "^4.3.3"
  }
}
