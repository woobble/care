{
  "name": "@care/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "build": "bun build src/main.ts src/migrate.ts --outdir dist --target bun --packages external",
    "openapi": "bun run src/openapi.ts",
    "migrate": "bun run src/migrate.ts",
    "seed": "bun run src/seed.ts",
    "seed:identity": "bun run src/seed-identity.ts",
    "test:integration": "bun test --timeout=300000 --parallel=1 ./integration",
    "lint": "oxlint src",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit --pretty false -p tsconfig.json",
    "test": "bun test src"
  },
  "dependencies": {
    "@care/audit": "workspace:*",
    "@care/auth": "workspace:*",
    "@care/benefits": "workspace:*",
    "@care/billing": "workspace:*",
    "@care/care-documentation": "workspace:*",
    "@care/clients": "workspace:*",
    "@care/communications": "workspace:*",
    "@care/config": "workspace:*",
    "@care/contracts": "workspace:*",
    "@care/database": "workspace:*",
    "@care/documents": "workspace:*",
    "@care/employees": "workspace:*",
    "@care/events": "workspace:*",
    "@care/identity": "workspace:*",
    "@care/logging": "workspace:*",
    "@care/observability": "workspace:*",
    "@care/onboarding": "workspace:*",
    "@care/operations": "workspace:*",
    "@care/organizations": "workspace:*",
    "@care/permissions": "workspace:*",
    "@care/platform": "workspace:*",
    "@care/scheduling": "workspace:*",
    "@care/service-agreements": "workspace:*",
    "@care/service-evidence": "workspace:*",
    "@care/services": "workspace:*",
    "@care/storage": "workspace:*",
    "@care/visit-execution": "workspace:*",
    "@fastify/helmet": "^13.1.2",
    "@fastify/multipart": "^10.1.3",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "dotenv": "^18.0.6",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@care/testing": "workspace:*",
    "jose": "^6.2.12"
  }
}
